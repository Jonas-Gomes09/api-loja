<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FastLibrary > Loja</title>
    <link href="/css/lista.css" rel="stylesheet">
</head>
<body>
    <script>
async function deletar(id) {
        console.log("Tentando deletar o ID:", id); // Teste se o clique funciona
        
        if (!confirm("Deseja mesmo excluir?")) return;

        try {
            const response = await fetch(`/loja/${id}`, { method: 'DELETE' });
        } catch {
            console.error("Erro na requisição");
        }
        window.location.href="/loja"
    }
    </script>
    <img class="background" src="/images/backgroundimage.png">
    <header>
        <div class="headermenu">
            <button class="headermenubutton" onclick="window.location.href='/'">INÍCIO</button>
            <button class="headermenubutton" onclick="window.location.href='/loja'">LOJA</button>
            <button class="headermenubutton" onclick="window.location.href='/loja/adicionar'">ADICIONAR PRODUTO</button>
        </div>
    </header>
        <main>
            <div class="texto">
                <h1>Loja</h1>
                <% if (lista.length < 1) { %>
                <p class="listap">
                 Desculpe, ainda não há nenhum produto na loja.
                </p>
                <% } else if (lista.length == 1) { %>
                <p class="listap">
                 Há 1 produto na loja atualmente.
                </p>
                <% } else { %>
                <p class="listap">
                 Há <%= lista.length %> produtos na loja atualmente.
                </p>
                <% } %>
            </div>
        </div>
        <% for (i = 0; i < lista.length; i++) { %>
        <div class="produto">
            <div class="produtofoto">
                <h1>?</h1>
            </div>
            <div class="produtodescricao">
                <h1 class="produtoh1"><%= lista[i].titulo %></h1>
                <p class="produtop">Autor: <%= lista[i].autor %></p>
                <p class="produtop">Publicado em: <%= lista[i].ano %></p>
                <p class="produtop">Gênero: <%= lista[i].genero %></p>
                <p class="produtop"><% if (lista[i].disponivel === true) { %> Disponível <% } else { %> Indisponível <% } %></p>
            </div>
            <div class="produtoopcoes">
                <button onclick="window.location.href='/loja/<%= i + 1 %>'" class="acessarproduto">ACESSAR PÁGINA</button>
                <button onclick="window.location.href='/loja/update/<%= lista[i].id %>'" class="atualizarproduto">ATUALIZAR</button>
                <button type="button" onclick="deletar('<%= lista[i].id %>')" class="excluirproduto">EXCLUIR</button>
            </div>
        </div>
        <% } %>
        <button class="importantbutton" onclick="window.location.href='/loja/adicionar'">ADICIONAR LIVRO</button>
    </main>
</body>
</html>