<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="/css/lista.css" rel="stylesheet">
</head>
<body>
    <img class="background" src="/images/backgroundimage.png">
    <header>
        <div class="headermenu">
            <button class="headermenubutton" onclick="window.location.href='/'">INÍCIO</button>
            <button class="headermenubutton" onclick="window.location.href='/lista'">LOJA</button>
            <button class="headermenubutton" onclick="window.location.href='/lista/adicionar'">ADICIONAR PRODUTO</button>
        </div>
        <input class="pesquisar" type="text" placeholder="Pesquisar livro">
    </header>
        <main>
            <div class="texto">
                <h1>Loja</h1>
                <% if (lista.length < 1) { %>
                <p class="listap">
                 Desculpe, ainda não há nenhum produto na loja.
                </p>
                <% } else if (lista.length == 1) { %>
                <p class="listap">
                 Há 1 produto na loja atualmente.
                </p>
                <% } else { %>
                <p class="listap">
                 Há <%= lista.length %> produtos na loja atualmente.
                </p>
                <% } %>
            </div>
        </div>
        <% for (i = 0; i < lista.length; i++) { %>
        <div class="produto">
            <div class="produtofoto">
                <h1>?</h1>
            </div>
            <div class="produtodescricao">
                <h1 class="produtoh1"><%= lista[i].titulo %></h1>
                <p class="produtop"><%= lista[i].ano %></p>
                <p class="produtop"><%= lista[i].genero %></p>
                <p class="produtop"><%= lista[i].disponivel %></p>
            </div>
            <div class="produtobotoes">
            </div>
        </div>
        <% } %>
        <button class="importantbutton" onclick="window.location.href='/lista/adicionar'">ADICIONAR LIVRO</button>
    </main>
</body>
</html>