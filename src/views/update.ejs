<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FastLibrary > Adicionar</title>
    <link href="/css/adicionar.css" rel="stylesheet">
</head>
<body>
    <img class="background" src="/images/backgroundimage.png">
    <header>
        <div class="headermenu">
            <button class="headermenubutton" onclick="window.location.href='/'">INÍCIO</button>
            <button class="headermenubutton" onclick="window.location.href='/loja'">LOJA</button>
            <button class="headermenubutton" onclick="window.location.href='/loja/adicionar'">ADICIONAR PRODUTO</button>
        </div>
    </header>
    <main>
        <h1>Atualizar Livro</h1>
        <div class="areaformulario">
            <form action="/loja/update/<%= livro.id %>?_method=PUT" method="post">
                <label for="titulo">Titulo:</label>
                <input class="textinput" type="text" id="titulo" name="titulo" placeholder="Título do livro" required value="<%= livro.titulo %>">

                <label for="autor">Autor:</label>
                <input class="textinput" type="text" id="autor" name="autor" placeholder="Autor do livro" required value="<%= livro.autor %>">

                <label for="ano">Ano:</label>
                <input class="numberinput" type="number" id="ano" name="ano" placeholder="Ano de lançamento" required value="<%= livro.ano %>">

                <select class="selectinput" id="genero" name="genero" required>
                    <optgroup label="Literatura e Ficção">
                        <option value="Ficção Histórica">Ficção Histórica</option>
                        <option value="Policial">Policial</option>
                        <option value="Suspense">Suspense</option>
                        <option value="Fantasia Épica">Fantasia Épica</option>
                        <option value="Horror Gótico">Horror Gótico</option>
                        <option value="Realismo Mágico">Realismo Mágico</option>
                    </optgroup>

                    <optgroup label="Conhecimento e Realidade">
                        <option value="Autobiografia e Memórias">Autobiografia e Memórias</option>
                        <option value="Ciências Políticas">Ciências Políticas</option>
                        <option value="Psicologia e Saúde Mental">Psicologia e Saúde Mental</option>
                        <option value="Tecnologia e Inovação">Tecnologia e Inovação</option>
                        <option value="Espiritualidade e Religião">Espiritualidade e Religião</option>
                    </optgroup>
                </select>

                <label for="disponivel">Disponível?</label>
                <input class="checkboxinput" type="checkbox" id="checkboxDisponivel" name="checkboxDisponivel">

                <button class="submit" type="submit">ATUALIZAR LIVRO</button>
            </form>
        </div>
    </main>
</body>
</html>